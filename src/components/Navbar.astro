---
const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#playground', label: 'Playground' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-[var(--color-bg)]/85 backdrop-blur-md border-b-[3px] border-[var(--color-ink)]"
  id="navbar"
>
  <!-- Bottom accent line -->
  <div class="nav-accent-line" aria-hidden="true"></div>

  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16" aria-label="Main navigation">
    <!-- Logo / Name + taghue badge -->
    <div class="flex items-center gap-2">
      <a
        href="#home"
        class="font-display font-bold text-lg tracking-tight text-[var(--color-ink)] no-underline hover:text-[var(--color-coral)] transition-colors interactive"
      >
        <span class="font-mono text-[var(--color-coral)]">&gt;</span> Amir_
      </a>
      <!-- taghue brand badge -->
      <span
        class="hidden sm:inline-flex items-center px-2 py-0.5 font-mono text-[10px] font-bold tracking-wider uppercase bg-[var(--color-acid)] text-[var(--color-ink)] border-[1.5px] border-[var(--color-ink)] rounded-[var(--radius-brutal)]"
        aria-label="Brand: taghue"
      >
        taghue
      </span>
    </div>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-1" id="nav-list">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="nav-link px-3 py-2 font-display text-sm font-medium tracking-tight text-[var(--color-ink-light)] no-underline rounded-sm transition-all duration-200 hover:text-[var(--color-ink)] hover:bg-[var(--color-surface-alt)] interactive"
            data-section={link.href.replace('#', '')}
          >
            {link.label}
          </a>
        </li>
      ))}
      <!-- Theme toggle -->
      <li class="ml-1">
        <button
          id="theme-toggle"
          class="theme-toggle interactive"
          aria-label="Toggle dark mode"
          aria-pressed="false"
        >
          <!-- Sun icon -->
          <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- Moon icon -->
          <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </li>
      <!-- Resume button -->
      <li class="ml-1">
        <a
          href="#"
          class="brutal-btn text-sm py-1.5 px-3 interactive"
        >
          Resume
        </a>
      </li>
    </ul>

    <!-- Mobile: theme toggle + hamburger -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="theme-toggle-mobile"
        class="theme-toggle interactive"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button
        class="menu flex flex-col gap-1.5 p-2 bg-transparent border-none cursor-pointer interactive"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        id="mobile-menu-btn"
      >
        <span class="block w-6 h-[3px] bg-[var(--color-ink)] rounded-sm transition-transform duration-200 origin-center"></span>
        <span class="block w-6 h-[3px] bg-[var(--color-ink)] rounded-sm transition-opacity duration-200"></span>
        <span class="block w-6 h-[3px] bg-[var(--color-ink)] rounded-sm transition-transform duration-200 origin-center"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div
    class="nav-links hidden md:hidden bg-[var(--color-bg)] border-t-[3px] border-[var(--color-ink)] absolute top-16 left-0 right-0 px-4 pb-4"
    id="mobile-menu"
  >
    <ul class="flex flex-col gap-1 list-none m-0">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="nav-link block px-4 py-3 font-display font-medium text-[var(--color-ink-light)] no-underline rounded-sm hover:bg-[var(--color-surface-alt)] hover:text-[var(--color-ink)] transition-colors interactive"
            data-section={link.href.replace('#', '')}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2">
        <a href="#" class="brutal-btn block text-center interactive">Resume</a>
      </li>
    </ul>
  </div>
</header>

<script>
  // ===== Theme Toggle (shared by desktop + mobile buttons) =====
  (function() {
    const toggles = document.querySelectorAll('#theme-toggle, #theme-toggle-mobile');
    const html = document.documentElement;

    function updateToggles() {
      const isDark = html.classList.contains('dark');
      toggles.forEach(btn => {
        btn.setAttribute('aria-pressed', String(isDark));
      });
    }

    updateToggles();

    toggles.forEach(btn => {
      btn.addEventListener('click', () => {
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateToggles();
      });
    });
  })();

  // ===== Mobile menu toggle =====
  (function() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const bars = menuBtn?.querySelectorAll('span');

    menuBtn?.addEventListener('click', () => {
      const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isOpen));

      if (!isOpen) {
        mobileMenu?.classList.remove('hidden');
        bars?.[0]?.classList.add('translate-y-[7px]', 'rotate-45');
        bars?.[1]?.classList.add('opacity-0');
        bars?.[2]?.classList.add('-translate-y-[7px]', '-rotate-45');
      } else {
        mobileMenu?.classList.add('hidden');
        bars?.[0]?.classList.remove('translate-y-[7px]', 'rotate-45');
        bars?.[1]?.classList.remove('opacity-0');
        bars?.[2]?.classList.remove('-translate-y-[7px]', '-rotate-45');
      }
    });

    // Close mobile menu on link click
    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
        bars?.[0]?.classList.remove('translate-y-[7px]', 'rotate-45');
        bars?.[1]?.classList.remove('opacity-0');
        bars?.[2]?.classList.remove('-translate-y-[7px]', '-rotate-45');
      });
    });
  })();

  // ===== Active section highlighting =====
  (function() {
    const sections = ['home', 'about', 'projects', 'skills', 'playground', 'contact'];
    const navLinks = document.querySelectorAll('.nav-link[data-section]');

    const observer = new IntersectionObserver((entries) => {
      let activeSection = null;
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          activeSection = entry.target.id;
        }
      });

      if (activeSection) {
        navLinks.forEach(link => {
          const section = link.getAttribute('data-section');
          if (section === activeSection) {
            link.style.color = 'var(--color-coral)';
            link.classList.add('font-semibold');
          } else {
            link.style.color = '';
            link.classList.remove('font-semibold');
          }
        });
      }
    }, {
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0,
    });

    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  })();
</script>
