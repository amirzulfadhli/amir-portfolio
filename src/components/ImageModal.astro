<!--
  ImageModal — reusable lightbox overlay for full-resolution image viewing.
  Usage: any element with data-lightbox-img and data-lightbox-alt attributes
  will open this modal on click. The modal supports:
  - Click outside / close button / Escape key to close
  - Left/Right arrow keys to navigate between images in a gallery
  - Stores current gallery set via data attribute

  Import and include once per page (typically in Projects section or BaseLayout).
-->
<div class="lightbox-overlay" id="lightbox-overlay" aria-hidden="true" role="dialog" aria-label="Image lightbox">
  <!-- Close button -->
  <button class="lightbox-close interactive" id="lightbox-close" aria-label="Close lightbox">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <!-- Previous button -->
  <button class="lightbox-nav prev interactive" id="lightbox-prev" aria-label="Previous image">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>

  <!-- Image -->
  <img id="lightbox-img" src="" alt="" />

  <!-- Next button -->
  <button class="lightbox-nav next interactive" id="lightbox-next" aria-label="Next image">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <!-- Caption -->
  <div class="lightbox-caption" id="lightbox-caption"></div>
</div>

<script>
  (function() {
    const overlay = document.getElementById('lightbox-overlay');
    const img = document.getElementById('lightbox-img');
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let currentImages = [];
    let currentIndex = 0;

    function open(imageSrc, alt, imagesArray, index) {
      currentImages = imagesArray || [{ src: imageSrc, alt: alt || '' }];
      currentIndex = index !== undefined ? index : 0;
      showImage(currentIndex);
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      updateNavButtons();
    }

    function close() {
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      currentImages = [];
      currentIndex = 0;
    }

    function showImage(index) {
      if (index < 0 || index >= currentImages.length) return;
      currentIndex = index;
      const item = currentImages[index];
      img.src = item.src;
      img.alt = item.alt || '';
      caption.textContent = item.alt || '';
      updateNavButtons();
    }

    function updateNavButtons() {
      prevBtn.style.display = currentImages.length > 1 && currentIndex > 0 ? 'flex' : 'none';
      nextBtn.style.display = currentImages.length > 1 && currentIndex < currentImages.length - 1 ? 'flex' : 'none';
    }

    function next() {
      if (currentIndex < currentImages.length - 1) {
        showImage(currentIndex + 1);
      }
    }

    function prev() {
      if (currentIndex > 0) {
        showImage(currentIndex - 1);
      }
    }

    // Close handlers
    closeBtn?.addEventListener('click', close);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    // Navigation
    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);

    // Keyboard
    document.addEventListener('keydown', (e) => {
      if (!overlay?.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    // Expose global API
    window.openLightbox = open;
    window.closeLightbox = close;

    // Wire up all elements with data-lightbox-img attribute
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-lightbox-img]');
      if (!trigger) return;

      const src = trigger.getAttribute('data-lightbox-img');
      const alt = trigger.getAttribute('data-lightbox-alt') || '';

      // Check if this trigger belongs to a gallery group
      const galleryId = trigger.getAttribute('data-lightbox-gallery');
      if (galleryId) {
        const allInGroup = document.querySelectorAll(`[data-lightbox-gallery="${galleryId}"]`);
        const images = Array.from(allInGroup).map(el => ({
          src: el.getAttribute('data-lightbox-img'),
          alt: el.getAttribute('data-lightbox-alt') || '',
        }));
        const idx = images.findIndex(item => item.src === src);
        open(src, alt, images, idx >= 0 ? idx : 0);
      } else {
        open(src, alt, [{ src, alt }], 0);
      }
    });
  })();
</script>
