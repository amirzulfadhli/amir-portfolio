<section
  id="home"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[var(--color-bg)]"
>
  <!-- Dot grid background -->
  <div class="dot-grid"></div>
  <!-- Subtle scanline overlay -->
  <div class="scanlines"></div>
  <!-- Mesh gradient overlay (dark mode only) -->
  <div class="mesh-gradient" aria-hidden="true"></div>

  <!-- Animated SVG circuit doodle in background -->
  <svg
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] opacity-[0.06] dark:opacity-[0.08] pointer-events-none hidden lg:block"
    viewBox="0 0 600 600"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Circuit nodes -->
    <circle cx="100" cy="100" r="6" fill="currentColor" class="text-[var(--color-coral)] dark:text-[var(--color-cyan)]" />
    <circle cx="500" cy="80" r="8" fill="currentColor" class="text-[var(--color-acid)] dark:text-[var(--color-violet)]" />
    <circle cx="300" cy="500" r="6" fill="currentColor" class="text-[var(--color-coral)] dark:text-[var(--color-cyan)]" />
    <circle cx="520" cy="450" r="6" fill="currentColor" class="text-[var(--color-sage)] dark:text-[var(--color-teal)]" />
    <circle cx="80" cy="420" r="8" fill="currentColor" class="text-[var(--color-acid)] dark:text-[var(--color-violet)]" />
    <circle cx="480" cy="280" r="4" fill="currentColor" class="text-[var(--color-coral)] dark:text-[var(--color-cyan)]" />
    <circle cx="150" cy="300" r="4" fill="currentColor" class="text-[var(--color-sage)] dark:text-[var(--color-teal)]" />
    <!-- Circuit traces -->
    <path d="M100 100 L100 200 L200 200 L200 300 L300 300" stroke="currentColor" stroke-width="2" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
    <path d="M500 80 L500 150 L400 150 L400 250 L300 250" stroke="currentColor" stroke-width="2" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
    <path d="M300 500 L300 400 L400 400 L400 350 L500 350 L500 450" stroke="currentColor" stroke-width="2" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
    <path d="M80 420 L200 420 L200 350" stroke="currentColor" stroke-width="2" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
    <path d="M480 280 L400 280 L400 300" stroke="currentColor" stroke-width="2" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
    <path d="M150 300 L200 300" stroke="currentColor" stroke-width="1.5" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
    <!-- Dashed connections -->
    <path d="M200 200 L500 80" stroke="currentColor" stroke-width="1" stroke-dasharray="8 8" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
    <path d="M300 250 L300 400" stroke="currentColor" stroke-width="1" stroke-dasharray="8 8" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
    <path d="M200 350 L300 300" stroke="currentColor" stroke-width="1" stroke-dasharray="6 6" class="text-[var(--color-ink)] dark:text-[var(--color-dark-border)]" />
  </svg>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 sm:px-6 max-w-4xl mx-auto">
    <!-- Sticker badge + taghue badge row -->
    <div class="animate-on-scroll flex items-center justify-center gap-3 mb-8 flex-wrap">
      <div class="sticker-badge">
        &#x26A1; Open to collaborations
      </div>
      <!-- taghue brand badge -->
      <span
        class="hidden sm:inline-flex items-center px-3 py-1 font-mono text-xs font-bold tracking-wider uppercase bg-[var(--color-ink)] text-[var(--color-acid)] dark:bg-[var(--color-cyan)] dark:text-[#0B0F17] border-[2px] border-[var(--color-ink)] dark:border-[var(--color-cyan)] rounded-[var(--radius-brutal)] shadow-[var(--shadow-brutal-sm)] dark:shadow-[var(--shadow-glow-cyan)]"
      >
        taghue
      </span>
    </div>

    <!-- Name -->
    <h1 class="animate-on-scroll font-display font-bold text-5xl sm:text-6xl md:text-7xl lg:text-8xl tracking-[-0.04em] text-[var(--color-ink)] mb-4">
      Amir Zulfadhli
    </h1>

    <!-- Title -->
    <p class="animate-on-scroll font-mono text-sm sm:text-base md:text-lg text-[var(--color-coral)] dark:text-[var(--color-cyan)] mb-6 tracking-wide">
      Full-Stack Developer &middot; IoT Engineer &middot; ML Builder
    </p>

    <!-- Tagline -->
    <p class="animate-on-scroll font-display text-xl sm:text-2xl md:text-3xl text-[var(--color-ink-light)] max-w-2xl mx-auto mb-10 leading-relaxed">
      Building at the intersection of <span class="text-[var(--color-coral)] dark:text-[var(--color-cyan)] font-semibold">hardware</span>, <span class="text-[var(--color-coral)] dark:text-[var(--color-cyan)] font-semibold">software</span>, and <span class="text-[var(--color-coral)] dark:text-[var(--color-cyan)] font-semibold">machine intelligence</span>&thinsp;&mdash;&thinsp;where robots learn and data moves things.
    </p>

    <!-- CTA Buttons -->
    <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#projects" class="brutal-btn text-base px-8 py-3 interactive">
        View Projects
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#contact" class="brutal-btn brutal-btn--dark text-base px-8 py-3 interactive">
        Contact Me
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4l6 4 6-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="animate-on-scroll mt-16 flex flex-col items-center gap-2 opacity-60">
      <span class="font-mono text-xs tracking-widest uppercase text-[var(--color-muted)]">Scroll</span>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        class="animate-bounce text-[var(--color-muted)]"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</section>
